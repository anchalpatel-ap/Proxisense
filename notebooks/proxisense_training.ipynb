   "source": [
    "# ProxiSense \u2014 LSTM Intent Prediction Training\n",
    "### Run on **Kaggle GPU** (attach JAAD dataset) or **Colab**\n",
    "\n",
    "This notebook:\n",
    "1. Parses JAAD pedestrian trajectories + crossing intent (if available)\n",
    "2. Generates synthetic data for underrepresented classes\n",
    "3. Trains LSTM on combined data\n",
    "4. Exports ONNX for edge deployment"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === 1. Setup ===\n",
    "import os, sys, json, glob, xml.etree.ElementTree as ET\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "from collections import defaultdict\n",
    "\n",
    "ON_KAGGLE = 'KAGGLE_KERNEL_RUN_TYPE' in os.environ\n",
    "ON_COLAB = 'COLAB_GPU' in os.environ\n",
    "print(f'Platform: {\"Kaggle\" if ON_KAGGLE else \"Colab\" if ON_COLAB else \"Local\"}')\n",
    "print(f'GPU available: {os.system(\"nvidia-smi\" if not os.name==\"nt\" else \"where nvidia-smi\") == 0}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
